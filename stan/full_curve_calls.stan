
    mag_ref   = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, x_p_bar, x_psi_bar, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
    mag_qlo   = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, x_p_bar - x_p_sd, x_psi_bar, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
    mag_qhi   = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, x_p_bar + x_p_sd, x_psi_bar, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
    mag_plo   = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, x_p_bar, x_psi_bar - x_psi_sd, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
    mag_phi   = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, x_p_bar, x_psi_bar + x_psi_sd, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
    mag_zero  = zp - inv * col(log_flux(dt_fig, band_fig, 0.0, mp, cl, xst, 0.0, 0.0, dtm, a, b, c, d, pmin, pmax, smin, smax, eps, eps_t, eps_s, zp, Kq, vlo, vhi, delta_p, Kpsi, ulo, uhi, delta, m, J, edges_v, Xv_nodes, jacw_v, edges_u, Xu_nodes, jacw_u, xg, wg, P0, T), 1);
